+#include "recovery_controller.hpp"
+#include <cstdio>
+#include <string_view>
+using lsfgvk::layer::RecoveryController;
+int main() {
+    int errors=0;
+    auto check=[&](bool ok,const char* name){std::printf("%s %s\n",ok?"PASS":"FAIL",name); errors+=!ok;};
+    RecoveryController c; unsigned n=c.update(0,1,72,true);
+    bool probed=false,returned=false;
+    // 2x: 40 total FPS; native: 30 total FPS. Faster originals are NOT a gain.
+    for(int i=0;i<100;++i){n=c.update(n?50:1000.0/30,1,72,true);probed|=!n;if(probed && n){returned=true;break;}}
+    check(probed && returned,"native source speedup must not reduce total output");
+    bool steady=true;
+    for(int i=0;i<1200;++i){n=c.update(n?50:1000.0/30,1,72,true);steady &= n==1;}
+    check(steady,"unchanged capped cadence does not repeat a failed native probe");
+    // Severe overload: 2x 20 total FPS vs native30. Native should be accepted.
+    c.reset();n=c.update(0,1,72,true);bool low=false;
+    for(int i=0;i<70;++i){n=c.update(n?100:1000.0/30,1,72,true);if(!n)low=true;}
+    check(low && n==0,"native remains available when total output improves");
+    // GPU recovers: 2x 40 FPS now beats native30, even though originals slow.
+    // Observe beyond every trial/cooldown, not just one momentary up-trial.
+    for(int i=0;i<1200;++i)n=c.update(n?50:1000.0/30,1,72,true);
+    bool restored=true;
+    for(int i=0;i<1200;++i){n=c.update(n?50:1000.0/30,1,72,true);restored &= n==1;}
+    check(restored,"restored output remains enabled after recovery trials");
+    // Identical output is insufficient reason to keep 2x disabled.
+    c.reset();n=c.update(0,1,72,true);probed=false;returned=false;
+    for(int i=0;i<100;++i){n=c.update(n?1000.0/30:1000.0/60,1,72,true);probed|=!n;if(probed&&n){returned=true;break;}}
+    check(probed&&returned,"equal output does not hold capped mode at native");
+    // The rejected probe latch must allow a later genuinely worse workload.
+    bool accepted=false;
+    for(int i=0;i<400;++i){
+        n=c.update(n?100:1000.0/30,1,72,true);
+        if(!n && std::string_view(c.phase())=="reduced"){accepted=true;break;}
+    }
+    for(int i=0;i<35;++i){n=c.update(n?100:1000.0/30,1,72,true);accepted &= n==0;}
+    check(accepted,"materially worse workload can retry a rejected backoff");
+    return errors?1:0;
+}
