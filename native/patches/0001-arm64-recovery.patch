+    auto result = h.run(&info, smooth, outputs);
+    ++cases;
+    if (result != expected || (hasResults && per != expected)) {
+     ++failures;
+     std::printf("FAIL split status smooth=%d outputs=%u pResults=%d status=%d got=%d per=%d\n",
+      smooth, outputs, hasResults, status, result, per);
+    }
+   }
+   for (VkResult error : {VK_ERROR_OUT_OF_HOST_MEMORY, VK_ERROR_OUT_OF_DEVICE_MEMORY}) {
+    Harness h;
+    driverCalls = 0; driverReturn = error; driverPer = error; per = VK_NOT_READY;
+    auto failed = h.run(&info, smooth, outputs);
+    ++cases;
+    if (failed != error || (hasResults && per != error)) ++failures;
+    driverReturn = driverPer = VK_SUCCESS;
+    auto recovered = h.run(&info, smooth, outputs);
+    if (recovered != VK_SUCCESS || driverCalls != 2 || (hasResults && per != VK_SUCCESS)) {
+     ++failures;
+     std::printf("FAIL final retry smooth=%d outputs=%u pResults=%d error=%d result=%d calls=%u\n",
+      smooth, outputs, hasResults, error, recovered, driverCalls);
+    }
+   }
+   // A stale caller value must not override a new successful driver result.
+   Harness h; driverReturn = driverPer = VK_SUCCESS; per = VK_ERROR_OUT_OF_DATE_KHR;
+   ++cases;
+   if (h.run(&info, smooth, outputs) != VK_SUCCESS || (hasResults && per != VK_SUCCESS)) ++failures;
+   // Generated SUBOPTIMAL survives a successful original; original errors win.
+   for (VkResult original : {VK_SUCCESS, VK_ERROR_OUT_OF_DATE_KHR}) {
+    Harness generated; driverReturn = original; driverPer = original;
+    auto expected = original == VK_SUCCESS ? VK_SUBOPTIMAL_KHR : original;
+    ++cases;
+    if (generated.run(&info, smooth, outputs, VK_SUBOPTIMAL_KHR) != expected ||
+        (hasResults && per != expected)) ++failures;
+   }
+  }
+ }
+ std::printf("%s %u cases, %u failures: final status and retry recovery at 2x/3x/4x\n",
+             failures ? "FAIL" : "PASS", cases, failures);
+ return failures ? 1 : 0;
+}
