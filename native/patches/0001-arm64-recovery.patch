+/* SPDX-License-Identifier: CC-BY-NC-ND-4.0 */
+#pragma once
+#include <algorithm>
+#include <cstdint>
+namespace lsfgvk::layer {
+// Used by one worker in order. Late frames rebase the following deadline.
+class PresentSchedule {
+public:
+    PresentSchedule(int64_t firstNs, int64_t gapNs) : lastNs_(firstNs), gapNs_(gapNs) {}
+    int64_t deadline(int64_t nowNs) const {
+        return enabled_ ? std::max(nowNs, lastNs_ + gapNs_) : nowNs;
+    }
