+#include "recovery_controller.hpp"
+#include <cstdio>
+#include <cstdlib>
+#include <limits>
+using lsfgvk::layer::RecoveryController;
+int failures=0;
+void check(bool ok,const char* name) {
+    std::printf("%s %s\n",ok?"PASS":"FAIL",name);
+    if(!ok) ++failures;
+}
+unsigned run(RecoveryController& c,double ms,int frames,unsigned req=1,unsigned cap=30) {
+    unsigned n=0;
+    for(int i=0;i<frames;++i) n=c.update(ms,req,cap,true);
+    return n;
+}
+int main() {
+    RecoveryController c;
+    c.update(0,1,30,true);
+    unsigned n=1;
+    int frames=0;
+    while(n && frames++<50) n=c.update(100,1,30,true);
+    check(n==0,"startup overload detects cap miss");
+    check(run(c,60,25)==1,"ineffective native probe rolls back");
+    bool quiet=true;
+    for(int i=0;i<33;++i) quiet &= c.update(60,1,30,true)==1;
+    check(quiet,"rejected probe cooldown");
+
+    c.reset();c.update(0,1,30,true);n=1;
+    for(int i=0;i<50 && n;++i) n=c.update(100,1,30,true);
+    bool recovered=false;
+    for(int i=0;i<600;++i) if(c.update(1000.0/30,1,30,true)==1){recovered=true;break;}
+    check(recovered,"higher level gets a bounded trial");
+    for(int i=0;i<25 && n!=0;++i) n=c.update(100,1,30,true);
+    // n was zero from the earlier backoff; explicitly observe enough trial frames.
+    n=run(c,100,25);
+    check(n==0,"failed ramp returns to native");
+    quiet=true;
+    for(int i=0;i<60;++i) quiet &= c.update(1000.0/30,1,30,true)==0;
+    check(quiet,"failed ramp does not oscillate");
+    check(c.update(33,1,60,true)==1,"cap change resets old lower level");
+    check(c.update(33,3,60,true)==3,"multiplier change resets controller");
+
+    c.reset();c.update(0,1,0,true);n=1;
+    for(int i=0;i<450 && n;++i) n=c.update(1000.0/30,1,0,true);
+    check(n==0,"uncapped native cadence probe is bounded");
+    check(run(c,1000.0/90,60,1,0)==0,"faster native cadence accepted");
+    recovered=false;
+    for(int i=0;i<1200;++i) if(c.update(1000.0/90,1,0,true)==1){recovered=true;break;}
+    check(recovered,"uncapped recovery trial");
+    check(run(c,1000.0/30,30,1,0)==0,"FIFO-hidden slowdown rejects recovery");
+
+    c.reset();c.update(0,1,30,true);
+    check(run(c,33.333,60)==1,"steady warmup");
+    check(c.update(500,1,30,true)==1,"loading pause is not overload");
+    check(run(c,33.333,60)==1,"loading recovers cadence measurement");
+    check(c.update(std::numeric_limits<double>::quiet_NaN(),1,30,true)==1,"invalid clock sample ignored");
+    check(c.update(-1,1,30,true)==1,"reversed clock sample ignored");
+    c.reset();c.update(0,1,30,true);
+    bool stable=true;
+    for(int i=0;i<900;++i) stable &= c.update(i%2?50:16.667,1,30,true)==1;
+    check(stable,"alternating intervals use mean cadence");
+    c.reset(); n=c.update(0,3,30,true);
+    bool reachedNative=false;
+    const double highCost[]{16,60,70,80};
+    for(int i=0;i<240;++i) {
+        n=c.update(highCost[n],3,30,true);
+        reachedNative |= n==0;
+    }
+    check(reachedNative,"fixed optical-flow cost does not trap high-multiplier backoff");
+    c.reset(); n=c.update(0,3,30,true);
+    bool triedNative=false, rolledBack=false;
+    for(int i=0;i<60;++i) {
+        n=c.update(80,3,30,true);
+        triedNative |= n==0;
+        if(triedNative && n==3) {rolledBack=true;break;}
+    }
+    check(triedNative && rolledBack,"all ineffective levels roll back in bounded time");
+    return failures?1:0;
+}
