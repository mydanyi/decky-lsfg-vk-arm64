+#pragma once
+
+// lsfgvk::layer::OutputSmoother
+//
+// Pure policy state machine for bounded experimental 2x/3x/4x submission smoothing.
+// It tracks observed QueuePresent cycle durations and derives a small pacing
+// gap. It performs no clocks, sleeps, or Vulkan calls, and makes no claim of
+// physical scanout or real FPS; it only yields a bounded policy gap.
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+
+namespace lsfgvk {
+namespace layer {
+
+class OutputSmoother {
+public:
+    OutputSmoother() { reset(); }
+
+    // Full configuration reset: clears all measurement state and the
+    // rejection latch.
+    void reset() {
+        enabled_ = false;
+        capFps_ = 0;
+        outputs_ = 2;
+        haveConfig_ = false;
+        rejected_ = false;
+        rejectionTrialMean_ = 0.0;
+        rejectionReference_ = 0.0;
+        confirmedRejection_ = false;
+        phase_ = Phase::Idle;
+        settleRemaining_ = 0;
+        baseline_ = 0.0;
+        gap_ = 0.0;
+        accumMs_ = 0.0;
+        accumSamples_ = 0;
+        attempt_ = 0;
+    }
+
+    // elapsedMs: cycle duration between original QueuePresent calls (>0, <=250).
+    double update(double elapsedMs, bool enabled, unsigned capFps, bool eligible = true,
+                  unsigned outputs = 2) {
+        // Config transition. Pausing preserves the rejection latch; an enable
+        // transition or a cap change is a config reset that clears it.
+        outputs = std::clamp(outputs, 2u, 4u);
+        if (!haveConfig_ || enabled != enabled_ || capFps != capFps_ || outputs != outputs_) {
+            const bool pause = haveConfig_ && !enabled;
+            if (pause) {
+                discardWindow();
+            } else {
+                resetMeasurement();
+            }
+            enabled_ = enabled;
+            capFps_ = capFps;
+            outputs_ = outputs;
+            haveConfig_ = true;
+        }
+
+        if (!enabled) {
+            phase_ = Phase::Disabled;
+            gap_ = 0.0;
+            return 0.0;
+        }
+
+        if (rejected_) {
+            phase_ = Phase::Rejected;
+            gap_ = 0.0;
+            return observeRejected(elapsedMs, eligible);
+        }
+
+        // Temporary native backoff is not an explicit user configuration
+        // change. Discard stale timing while preserving any rejection latch.
+        if (!eligible) {
+            resetMeasurement();
+            return 0.0;
+        }
+
+        // Only accept valid samples.
+        if (!std::isfinite(elapsedMs) || !(elapsedMs > 0.0) ||
+            elapsedMs > kMaxSampleMs) {
+            resetMeasurement();
+            return 0.0;
+        }
+
+        // Skip the settling frames after a mode change.
+        if (settleRemaining_ > 0) {
+            --settleRemaining_;
+            return gap_;
+        }
+
+        accumMs_ += elapsedMs;
+        ++accumSamples_;
+
+        if (accumMs_ >= kWindowMs && accumSamples_ >= kWindowSamples) {
+            const double mean = accumMs_ / static_cast<double>(accumSamples_);
+
+            if (phase_ == Phase::Warmup || phase_ == Phase::Idle) {
+                // Learn the source period and divide by the actual output count.
+                baseline_ = mean;
+                gap_ = std::min(kGapCapMs, baseline_ / outputs_);
+                attempt_ = 0;
+                phase_ = Phase::Trial;
+                startWindow();
+            } else {
+                startWindow();
+                evaluateWindow(mean);
+            }
+        }
+
+        return gap_;
+    }
+
+    double gapMs() const { return gap_; }
+    double sourcePeriodMs() const { return baseline_; }
+    unsigned outputCount() const { return outputs_; }
+
+    const char* phase() const {
+        switch (phase_) {
+            case Phase::Disabled: return "disabled";
+            case Phase::Warmup:   return "warmup";
+            case Phase::Trial:    return "trial";
+            case Phase::Active:   return "active";
+            case Phase::Rejected: return "rejected";
+            case Phase::Idle:
+            default:              return "idle";
+        }
+    }
+
+    // Deadline for an already-blocked present. Never adds delay when late,
+    // and rejects non-finite times by returning now.
+    static double deadlineMs(double generatedStart, double gap, double now) {
+        if (!std::isfinite(generatedStart) || !std::isfinite(gap) ||
+            !std::isfinite(now)) {
+            return now;
+        }
+        return std::max(now, generatedStart + gap);
+    }
+
+private:
+    enum class Phase : std::uint8_t {
+        Idle,
+        Disabled,
+        Warmup,
+        Trial,
+        Active,
+        Rejected
+    };
+
+    static constexpr double kMaxSampleMs = 250.0;
+    static constexpr double kWindowMs = 1000.0;
+    static constexpr unsigned kWindowSamples = 12;
+    static constexpr unsigned kSettleSamples = 3;
+    static constexpr double kGapCapMs = 25.0;
+    static constexpr double kRejectRatio = 0.95; // reject when mean > baseline / 0.95
+    static constexpr double kRelaxRatio = 0.85;  // relax when mean < baseline * 0.85
+    static constexpr unsigned kMaxAttempts = 3;  // initial, half, quarter
+
+    void startWindow() {
+        accumMs_ = 0.0;
+        accumSamples_ = 0;
+        settleRemaining_ = kSettleSamples;
+    }
+
+    void discardWindow() { startWindow(); }
+
+    void resetMeasurement() {
+        rejected_ = false;
+        rejectionTrialMean_ = 0.0;
+        rejectionReference_ = 0.0;
+        confirmedRejection_ = false;
+        baseline_ = 0.0;
+        gap_ = 0.0;
+        attempt_ = 0;
+        phase_ = Phase::Warmup;
+        startWindow();
+    }
+
+    double observeRejected(double elapsedMs, bool eligible)
+    {
+        if (!eligible)
+        {
+            startWindow();
+            return 0.0;
+        }
+
+        if (!std::isfinite(elapsedMs) || !(elapsedMs > 0.0) || elapsedMs > kMaxSampleMs)
+        {
+            startWindow();
+            return 0.0;
+        }
+
+        if (settleRemaining_ > 0) {
+            --settleRemaining_;
+            return 0.0;
+        }
+
+        accumMs_ += elapsedMs;
+        ++accumSamples_;
+
+        if (accumMs_ < kWindowMs || accumSamples_ < kWindowSamples)
+        {
+            return 0.0;
+        }
+
+        const double mean = accumMs_ / static_cast<double>(accumSamples_);
+
+        if (!confirmedRejection_)
+        {
+            if (mean >= rejectionTrialMean_ * kRejectRatio)
+            {
+                resetMeasurement();
+                baseline_ = mean;
+                gap_ = std::min(kGapCapMs, mean / outputs_);
+                phase_ = Phase::Trial;
+                startWindow();
+                return gap_;
+            }
+
+            confirmedRejection_ = true;
+            rejectionReference_ = mean;
+            startWindow();
+            return 0.0;
+        }
+
+        if (rejectionReference_ > 0.0 &&
+            std::abs(mean / rejectionReference_ - 1.0) > 0.15)
+        {
+            resetMeasurement();
+            baseline_ = mean;
+            gap_ = std::min(kGapCapMs, mean / outputs_);
+            phase_ = Phase::Trial;
+            startWindow();
+            return gap_;
+        }
+
+        startWindow();
+        return 0.0;
+    }
+
+    double rejectionTrialMean_ = 0.0;
+    double rejectionReference_ = 0.0;
+    bool confirmedRejection_ = false;
+
+    void evaluateWindow(double mean) {
+        if (phase_ == Phase::Trial || phase_ == Phase::Active) {
+            if (mean > baseline_ / kRejectRatio) {
+                // Current gap insufficient: halve it (initial -> half ->
+                // quarter). A third failed window rejects.
+                ++attempt_;
+                if (attempt_ < kMaxAttempts) {
+                    gap_ *= 0.5;
+                } else {
+                    gap_ = 0.0;
+                    rejected_ = true;
+                    rejectionTrialMean_ = mean;
+                    rejectionReference_ = 0.0;
+                    confirmedRejection_ = false;
+                    phase_ = Phase::Rejected;
+                }
+            } else {
+                phase_ = Phase::Active;
+                if (mean < baseline_ * kRelaxRatio) {
+                    baseline_ = mean;
+                    gap_ = std::min(gap_, baseline_ / outputs_);
+                }
+            }
+            return;
+        }
+    }
+
+    bool enabled_ = false;
+    unsigned capFps_ = 0;
+    unsigned outputs_ = 2;
+    bool haveConfig_ = false;
+    bool rejected_ = false;
+    Phase phase_ = Phase::Idle;
+
+    unsigned settleRemaining_ = 0;
+    double baseline_ = 0.0;
+    double gap_ = 0.0;
+    double accumMs_ = 0.0;
+    unsigned accumSamples_ = 0;
+    unsigned attempt_ = 0;
+};
+
