+#include "target_present_schedule.hpp"
+#include <cassert>
+#include <cstdio>
+using namespace lsfgvk::layer;
+int main() {
+    TargetPresentSchedule schedule;
+    int64_t now = 1000000000;
+    // Integer ratios remain uniform across source batches, including first output.
+    for (unsigned n : {2u, 3u, 4u}) {
+        schedule.reset();
+        for (unsigned batch = 0; batch < 8; ++batch) {
+            schedule.begin(24.0, n);
+            for (unsigned i = 0; i < n; ++i) {
+                const auto expected = (batch || i) ? now + 24000000 / n : now;
+                now = schedule.deadline(now);
+                assert(now == expected);
+                schedule.record(now);
+            }
+        }
+    }
+    // Fractional ratios distribute each selected batch over one source period.
+    schedule.reset();
+    schedule.begin(20.0, 2);
+    schedule.record(now);
+    assert(schedule.deadline(now) == now + 10000000);
+    schedule.begin(20.0, 3);
+    assert(schedule.deadline(now) == now + 6666666);
+    now = schedule.deadline(now); schedule.record(now);
+    schedule.begin(20.0, 1);
+    assert(schedule.deadline(now) == now + 20000000);
+    now = schedule.deadline(now); schedule.record(now);
+    schedule.begin(20.0, 3);
+    assert(schedule.deadline(now) == now + 6666666);
+    // Late work never accrues deadlines that can later burst together.
+    now += 100000000;
+    assert(schedule.deadline(now) == now);
+    schedule.record(now);
+    assert(schedule.deadline(now) == now + 6666666);
+    schedule.reset(); schedule.begin(20.0, 3);
+    assert(schedule.deadline(now) == now);
+    std::puts("PASS target cross-batch pacing, zero-generation continuity, late rebasing");
+}
