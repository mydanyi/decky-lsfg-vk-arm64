@@ -0,0 +1,27 @@
+#pragma once
+#include <cmath>
+
+namespace lsfgvk::layer {
+inline bool outputCadenceImproves(double previousMs,
+                                  unsigned previousGenerated,
+                                  double currentMs,
+                                  unsigned currentGenerated,
+                                  double requiredRatio)
+{
+    if (!std::isfinite(previousMs) || !std::isfinite(currentMs) ||
+        !std::isfinite(requiredRatio)) {
+        return false;
+    }
+    if (previousMs <= 0.0 || currentMs <= 0.0 || requiredRatio <= 0.0) {
+        return false;
+    }
+
+    const double previousTotal = static_cast<double>(previousGenerated) + 1.0;
+    const double currentTotal  = static_cast<double>(currentGenerated) + 1.0;
+
+    const double previousRate = previousTotal / previousMs;
+    const double currentRate  = currentTotal / currentMs;
+
+    return currentRate >= requiredRatio * previousRate;
+}
+}
