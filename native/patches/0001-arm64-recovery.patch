+#pragma once
+
+#include <algorithm>
+#include <cstdint>
+#include <optional>
+
+namespace lsfgvk::layer {
+
+// Scheduling principle informed by MAKO RealFramePacer e8043da;
+// this is adapted paired scheduling, not an upstream literal implementation.
+class PairPacer {
+public:
+    explicit PairPacer(std::int64_t halfPeriod)
+        : H(halfPeriod), M(std::max<std::int64_t>(1, H / 2)), T(2 * H) {}
+
+    std::int64_t generatedDeadline(std::int64_t ready) const {
+        if (!B)
+            return ready;
+
+        return std::max({ready, *B + H, *L + M});
+    }
+
+    std::int64_t originalDeadline(std::int64_t actualGenStart) {
+        if (B && actualGenStart <= *B + T - M) {
+            pendingOriginalDeadline = *B + T;
+            pendingRebase = false;
+        } else {
+            pendingOriginalDeadline = actualGenStart + H;
+            pendingRebase = true;
+        }
+
+        return *pendingOriginalDeadline;
+    }
+
+    void recordOriginal(std::int64_t actualOrigStart) {
+        if (!B || !pendingOriginalDeadline || pendingRebase ||
+            actualOrigStart > *pendingOriginalDeadline + H - M) {
+            B = actualOrigStart;
+        } else {
+            B = *pendingOriginalDeadline;
+        }
+
+        L = actualOrigStart;
+        pendingOriginalDeadline.reset();
+        pendingRebase = false;
+    }
+
+    void reset() {
+        B.reset();
+        L.reset();
+        pendingOriginalDeadline.reset();
+        pendingRebase = false;
+    }
+
+private:
+    std::int64_t H;
+    std::int64_t M;
+    std::int64_t T;
+    std::optional<std::int64_t> B;
+    std::optional<std::int64_t> L;
+    std::optional<std::int64_t> pendingOriginalDeadline;
+    bool pendingRebase = false;
+};
+
+} // namespace lsfgvk::layer
