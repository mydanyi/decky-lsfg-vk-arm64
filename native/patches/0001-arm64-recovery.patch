+/* SPDX-License-Identifier: CC-BY-NC-ND-4.0 */
+#pragma once
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+namespace lsfgvk::layer {
+// Cross-batch pacing for target mode. Every source interval is distributed over
+// the outputs actually selected for it, so integer ratios stay uniform across
+// batch boundaries and fractional ratios spread each batch over one source
+// period. Deadlines never accumulate: presenting late rebases the next one.
+class TargetPresentSchedule {
+public:
+    void begin(double sourcePeriodMs, unsigned outputs) {
+        if (!std::isfinite(sourcePeriodMs) || !(sourcePeriodMs > 0.0) || outputs == 0) {
+            gapNs_ = 0;
+            return;
+        }
+        gapNs_ = static_cast<int64_t>(sourcePeriodMs * 1e6) / static_cast<int64_t>(outputs);
+    }
+    int64_t deadline(int64_t nowNs) const {
+        if (gapNs_ <= 0) return nowNs;
+        return std::max(nowNs, lastNs_ + gapNs_);
+    }
+    void record(int64_t actualNs) { lastNs_ = actualNs; }
+    void reset() { lastNs_ = 0; gapNs_ = 0; }
+private:
+    int64_t lastNs_{0};
+    int64_t gapNs_{0};
+};
+}
