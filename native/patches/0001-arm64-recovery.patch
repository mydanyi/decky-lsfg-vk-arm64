+#pragma once
+#include <algorithm>
+#include <cmath>
+#include "recovery_predicate.hpp"
+
+namespace lsfgvk::layer {
+// Complete real-frame cycles include FIFO backpressure, not just GPU execution.
+class RecoveryController {
+public:
+    void reset() { *this = RecoveryController{}; }
+    unsigned update(double elapsedMs, unsigned requested, unsigned capFps, bool enabled) {
+        if (!m_initialized || requested != m_requested || capFps != m_cap || enabled != m_enabled) {
+            reset();
+            m_initialized = true;
+            m_requested = requested;
+            m_cap = capFps;
+            m_enabled = enabled;
+            m_current = m_committed = requested;
+            return m_current;
+        }
+        if (!enabled || !requested) return requested;
+        if (!std::isfinite(elapsedMs) || elapsedMs <= 0.0 || elapsedMs > 250.0) {
+            // Loading/resume is not evidence of sustained overload.
+            m_current = m_committed;
+            m_state = State::Steady;
+            m_slowWindows = 0;
+            m_worseWindows = 0;
+            clearWindow();
+            m_skip = 3;
+            m_nextTry = m_clock + 4000.0;
+            m_nextProbe = m_clock + 8000.0;
+            return m_current;
+        }
+        m_clock += elapsedMs;
+        if (m_skip) { --m_skip; return m_current; }
+        m_windowMs += elapsedMs;
+        ++m_samples;
+        if (m_windowMs < 500.0 || m_samples < 6) return m_current;
+        const double mean = m_windowMs / m_samples;
+        clearWindow();
+        if (m_state == State::DownTrial || m_state == State::NativeProbe) {
+            const double threshold = m_state == State::NativeProbe ? 0.75 : 0.85;
+            const double outputRatio = m_current ? 0.98 : 1.10;
+            if (mean <= m_beforeMs * threshold &&
+                outputCadenceImproves(m_beforeMs, m_committed, mean, m_current, outputRatio)) {
+                m_committed = m_current;
+                m_latestMs = mean;
+                if (!m_cap) m_referenceMs = mean;
+                m_retryMs = 4000.0;
+                m_nextTry = m_clock + m_retryMs;
+                m_state = State::Steady;
+            } else if (m_state == State::DownTrial && m_current > 0) {
+                // Fixed optical-flow cost can hide the benefit of one small step.
+                // Bound the search by the remaining levels and compare the whole
+                // probe to its original baseline before accepting or rolling back.
+                beginTrial(State::DownTrial, m_current - 1, m_beforeMs);
+            } else rejectTrial();
+            return m_current;
+        }
+        if (m_state == State::UpTrial) {
+            if (outputCadenceImproves(m_beforeMs, m_committed, mean, m_current, 1.05)) {
+                m_committed = m_current;
+                m_latestMs = mean;
+                m_retryMs = 4000.0;
+                m_nextTry = m_clock + m_retryMs;
+                m_nextProbe = m_clock + 8000.0;
+                m_state = State::Steady;
+            } else rejectTrial();
+            return m_current;
+        }
+        m_latestMs = mean;
+        if (m_referenceMs == 0.0) m_referenceMs = mean;
+        const double reference = m_cap ? 1000.0 / m_cap : m_referenceMs;
+        if (mean > reference * 1.25) m_slowWindows = std::min(2u, m_slowWindows + 1);
+        else {
+            m_slowWindows = 0;
+            if (!m_cap) m_referenceMs = std::min(m_referenceMs, mean);
+        }
+        if (m_failedDownMs && mean > m_failedDownMs * 1.15)
+            m_worseWindows = std::min(4u, m_worseWindows + 1);
+        else m_worseWindows = 0;
+        const bool retryDown = !m_cap || !m_failedDownMs ||
+            (m_worseWindows >= 4 && m_clock >= m_nextDownTry);
+        if (m_current && m_slowWindows >= 2 && m_clock >= m_nextTry && retryDown) {
+            beginTrial(State::DownTrial, m_current - 1, mean);
+        } else if (m_current < m_requested && m_clock >= m_nextTry) {
+            beginTrial(State::UpTrial, m_current + 1, m_latestMs);
+        } else if (!m_cap && m_current == m_requested && m_clock >= m_nextProbe && m_clock >= m_nextTry) {
+            // FIFO can hide a faster native cadence. Never remove a manual cap.
+            beginTrial(State::NativeProbe, 0, mean);
+        }
+        return m_current;
+    }
+    const char* phase() const {
+        switch (m_state) {
+            case State::DownTrial: return "backoff-trial";
+            case State::UpTrial: return "recovery-trial";
+            case State::NativeProbe: return "native-probe";
+            case State::Steady: return m_current < m_requested ? "reduced" : "steady";
+        }
+        return "steady";
+    }
+private:
+    enum class State { Steady, DownTrial, UpTrial, NativeProbe };
+    State m_state{State::Steady};
+    bool m_initialized{false}, m_enabled{false};
+    unsigned m_requested{0}, m_cap{0}, m_current{0}, m_committed{0};
+    unsigned m_samples{0}, m_slowWindows{0}, m_skip{0};
+    double m_clock{0}, m_windowMs{0}, m_referenceMs{0}, m_latestMs{0};
+    double m_beforeMs{0}, m_nextTry{0}, m_nextProbe{8000}, m_retryMs{4000};
+    double m_failedDownMs{0};
+    unsigned m_worseWindows{0};
+    double m_nextDownTry{0};
+    void clearWindow() { m_windowMs = 0; m_samples = 0; }
+    void beginTrial(State state, unsigned count, double before) {
+        m_state = state; m_current = count; m_beforeMs = before;
+        m_slowWindows = 0; m_skip = 3; clearWindow();
+    }
+    void rejectTrial() {
+        // A cap the game cannot reach is not evidence that generation hurts.
+        // Retry a failed capped backoff only after materially worse cadence.
+        if (m_cap && m_state == State::DownTrial) {
+            m_failedDownMs = m_beforeMs;
+            m_worseWindows = 0;
+            m_nextDownTry = m_clock + 30000.0;
+        }
+        m_current = m_committed; m_state = State::Steady;
+        m_retryMs = std::min(16000.0, m_retryMs * 2.0);
+        m_nextTry = m_clock + m_retryMs; m_nextProbe = m_clock + m_retryMs;
+        m_slowWindows = 0; m_skip = 3; clearWindow();
+    }
+};
+}
