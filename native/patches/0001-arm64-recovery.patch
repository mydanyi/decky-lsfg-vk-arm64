+#include "target_controller.hpp"
+#include <cmath>
+#include <cstdio>
+#include <cstring>
+#include <limits>
+using lsfgvk::layer::TargetController;
+int failures = 0;
+void check(bool ok, const char* name) {
+    std::printf("%s %s\n", ok ? "PASS" : "FAIL", name);
+    failures += !ok;
+}
+double average(TargetController& c, double ms, unsigned target, unsigned cap,
+               bool protection = false, int warmup = 120, int count = 600) {
+    unsigned n = 0;
+    double sum = 0;
+    for (int i = 0; i < warmup + count; ++i) {
+        n = c.update(ms, target, cap, protection, n + 1);
+        if (i >= warmup) sum += n + 1;
+    }
+    return sum / count;
+}
+bool near(double got, double expected, double tolerance = 0.015) {
+    return std::abs(got - expected) <= tolerance;
+}
+int main() {
+    TargetController c;
+    // Catches rounding the desired multiplier to one fixed integer.
+    check(near(average(c, 1000.0 / 30, 120, 3), 4), "30 to 120 uses four outputs");
+    c.reset();
+    check(near(average(c, 25, 120, 3), 3), "40 to 120 uses three outputs");
+    c.reset();
+    check(near(average(c, 1000.0 / 60, 120, 3), 2), "60 to 120 uses two outputs");
+    c.reset();
+    check(near(average(c, 20, 120, 3), 2.4), "50 to 120 averages 2.4 outputs");
+    c.reset();
+    check(near(average(c, 25, 60, 3), 1.5), "40 to 60 alternates real-only and generated output");
+    c.reset();
+    check(near(average(c, 10, 60, 3), 1), "native above target never generates");
+    c.reset();
+    check(near(average(c, 1000.0 / 60, 60, 3), 1), "native equal target never generates");
+    c.reset();
+    check(near(average(c, 50, 120, 3), 4), "20 to 120 respects maximum four outputs");
+    c.reset();
+    check(near(average(c, 50, 120, 0), 1), "zero maximum preserves real outputs");
+    c.reset();
+    check(near(average(c, 20, 120, 3, true), 2.4), "protection does not disable target scheduling");
+
+    // Configuration changes must discard a fractional budget and old trials.
+    c.reset();
+    average(c, 25, 60, 3);
+    check(c.update(25, 120, 3, false, 1) == 0, "target change starts a fresh measurement");
+    check(near(average(c, 25, 120, 3), 3), "changed target takes effect");
+    check(c.update(25, 120, 1, false, 3) == 0, "maximum change resets state");
+    check(near(average(c, 25, 120, 1), 2), "changed maximum takes effect");
+    check(c.update(25, 120, 1, true, 2) == 0, "protection change resets state");
+
+    // The rejected integer deficit must never be paid back later.
+    c.reset();
+    average(c, 200, 120, 3);
+    average(c, 1000.0 / 60, 120, 3, false, 120, 60);
+    unsigned n = 1;
+    bool noDebt = true;
+    for (int i = 0; i < 180; ++i) {
+        n = c.update(1000.0 / 60, 120, 3, false, n + 1);
+        noDebt &= n == 1;
+    }
+    check(noDebt, "capped integer deficit cannot accumulate");
+    const double invalid[]{0, -1, 250, 500, std::numeric_limits<double>::infinity(),
+                           std::numeric_limits<double>::quiet_NaN()};
+    bool resetOnInvalid = true;
+    for (double ms : invalid) {
+        average(c, 25, 60, 3);
+        resetOnInvalid &= c.update(ms, 60, 3, false, 2) == 0;
+        resetOnInvalid &= c.sourcePeriodMs() == 0;
+        resetOnInvalid &= near(average(c, 25, 60, 3), 1.5);
+    }
+    check(resetOnInvalid, "pause invalid and 250ms loading reset without debt");
+
+    // A fastest-sample estimator would incorrectly see 125 native FPS.
+    c.reset(); n = 0;
+    double sum = 0;
+    for (int i = 0; i < 1000; ++i) {
+        n = c.update(i % 2 ? 32 : 8, 120, 3, false, n + 1);
+        if (i >= 400) sum += n + 1;
+    }
+    check(near(sum / 600, 2.4, 0.05) && near(c.sourcePeriodMs(), 20, 0.6),
+          "8/32ms includes slow cycles and measures about 50 native FPS");
+
+    // A fixed flow cost hides native speed until the trial reaches zero work.
+    c.reset(); n = 0;
+    for (int i = 0; i < 120; ++i)
+        n = c.update(1000.0 / 30, 90, 3, true, n + 1);
+    const double costly[]{10, 45, 55, 65};
+    bool nativeSeen = false;
+    for (int i = 0; i < 1600; ++i) {
+        n = c.update(costly[n], 90, 3, true, n + 1);
+        if (i > 800) nativeSeen |= n == 0;
+    }
+    bool nativeHeld = true;
+    for (int i = 0; i < 1000; ++i) {
+        n = c.update(costly[n], 90, 3, true, n + 1);
+        nativeHeld &= n == 0;
+    }
+    check(nativeSeen && nativeHeld, "higher native output meeting target is retained without repeated FG probes");
+
+    // Constant slow native cadence cannot improve when work is removed.
+    c.reset(); n = 0;
+    for (int i = 0; i < 1000; ++i) n = c.update(50, 120, 3, true, n + 1);
+    bool cappedHeld = true;
+    for (int i = 0; i < 1000; ++i) {
+        n = c.update(50, 120, 3, true, n + 1);
+        cappedHeld &= n == 3;
+    }
+    check(cappedHeld, "unreachable target does not repeat ineffective backoff at unchanged load");
+
+    // Lower work wins by actual outputs/time even when planned outputs suggest otherwise.
+    c.reset(); n = 0;
+    for (int i = 0; i < 1800; ++i) {
+        const double ms = n == 0 ? 50 : (n == 1 ? 40 : 50);
+        const unsigned delivered = n > 1 ? 1 : n + 1;
+        n = c.update(ms, 120, 3, true, delivered);
+    }
+    unsigned reducedFrames = 0;
+    for (int i = 0; i < 500; ++i) {
+        const double ms = n == 0 ? 50 : (n == 1 ? 40 : 50);
+        n = c.update(ms, 120, 3, true, n > 1 ? 1 : n + 1);
+        reducedFrames += n == 1;
+    }
+    check(reducedFrames > 450, "actual delivered output keeps beneficial lower work despite failed submissions");
+    // Once heavy work becomes cheap, an unmet target gets a bounded upward trial.
+    unsigned recoveredFrames = 0;
+    for (int i = 0; i < 2200; ++i) {
+        n = c.update(25, 120, 3, true, n + 1);
+        if (i >= 2000) recoveredFrames += n == 2;
+    }
+    check(recoveredFrames > 190, "lower work recovers when measured delivery improves");
+    return failures ? 1 : 0;
+}
