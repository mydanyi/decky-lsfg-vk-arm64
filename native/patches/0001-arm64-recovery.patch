+template<class T> double update(T& p,unsigned outputs){
+ if constexpr(requires {p.update(1000.0/30,true,72,true,outputs);})
+  return p.update(1000.0/30,true,72,true,outputs);
+ else return p.update(1000.0/30,true,72,true);
+}
+template<class T> bool append(T& p,std::function<int()> job){
+ if constexpr(requires {p.append(job);})return p.append(job);
+ else return p.submit(job);
+}
+int main(int argc,char**){
+ if(argc==1){
+  OutputSmoother p;
+  for(unsigned n:{2,3,4,3,2,4}){
