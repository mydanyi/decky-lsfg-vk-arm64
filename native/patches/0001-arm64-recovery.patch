+#pragma once
+#include <algorithm>
+#include <cmath>
+
+namespace lsfgvk::layer {
+// elapsedMs covers a complete real Present cycle, including the preceding
+// model wait. Delivered outputs belong to that same preceding cycle.
+class TargetController {
+public:
+    void reset() { *this = TargetController{}; }
+
+    unsigned update(double elapsedMs, unsigned targetFps, unsigned maxGenerated,
+                    bool protection, unsigned previousDeliveredOutputs) {
+        if (!m_initialized || targetFps != m_target || maxGenerated != m_maximum ||
+            protection != m_protection || !std::isfinite(elapsedMs) ||
+            elapsedMs <= 0 || elapsedMs >= 250) {
+            reset();
+            m_initialized = true;
+            m_target = targetFps;
+            m_maximum = maxGenerated;
+            m_protection = protection;
+            m_ceiling = m_committed = maxGenerated;
+            return 0;
+        }
+
+        m_clock += elapsedMs;
+        m_windowMs += elapsedMs;
+        m_outputs += previousDeliveredOutputs;
+        ++m_samples;
+        // Until the first full window, include every sample in the estimate.
+        // Afterwards only complete windows replace it, so short/long alternating
+        // cycles cannot repeatedly masquerade as a fast native frame rate.
+        if (!m_haveWindow) m_sourceMs = m_windowMs / m_samples;
+        if (m_windowMs >= 500 && m_samples >= 8) {
+            m_sourceMs = m_windowMs / m_samples;
+            const double outputFps = 1000.0 * m_outputs / m_windowMs;
+            clearWindow();
+            m_haveWindow = true;
+            if (protection && targetFps && maxGenerated) observe(outputFps);
+        }
+
+        if (!targetFps || !m_ceiling || m_sourceMs * targetFps <= 1000.0 + 1e-8) {
+            m_budget = 0;
+            return 0;
+        }
+        m_budget += m_sourceMs * targetFps / 1000.0 - 1.0;
+        const double whole = std::floor(m_budget + 1e-9);
+        // Keep only the fractional remainder. Work refused by the ceiling is
+        // deliberately lost, never queued for a later burst of generated frames.
+        m_budget = std::max(0.0, m_budget - whole);
+        return static_cast<unsigned>(std::min(whole, static_cast<double>(m_ceiling)));
+    }
+
+    double sourcePeriodMs() const { return m_sourceMs; }
+    const char* phase() const {
+        if (m_state == State::DownTrial) return "backoff-trial";
+        if (m_state == State::UpTrial) return "recovery-trial";
+        return m_committed < m_maximum ? "reduced" : "steady";
+    }
+
+private:
+    enum class State { Steady, DownTrial, UpTrial };
+    State m_state{State::Steady};
+    bool m_initialized{false}, m_protection{false}, m_haveWindow{false};
+    unsigned m_target{0}, m_maximum{0}, m_ceiling{0}, m_committed{0};
+    unsigned m_samples{0}, m_slowWindows{0};
+    double m_clock{0}, m_windowMs{0}, m_outputs{0}, m_sourceMs{0}, m_budget{0};
+    double m_referenceMs{0}, m_beforeMs{0}, m_beforeFps{0};
+    double m_failedDownMs{0}, m_failedDownFps{0};
+    double m_nextTrial{0}, m_upRetryMs{8000};
+
+    void clearWindow() { m_windowMs = 0; m_outputs = 0; m_samples = 0; }
+
+    void beginTrial(State state, unsigned ceiling, double fps) {
+        m_state = state;
+        m_ceiling = ceiling;
+        m_beforeMs = m_sourceMs;
+        m_beforeFps = fps;
+        m_slowWindows = 0;
+        m_budget = 0;
+    }
+
+    void acceptTrial() {
+        m_committed = m_ceiling;
+        m_referenceMs = m_sourceMs;
+        m_state = State::Steady;
+        m_failedDownMs = m_failedDownFps = 0;
+        m_upRetryMs = 8000;
+        m_nextTrial = m_clock + m_upRetryMs;
+        m_slowWindows = 0;
+    }
+
+    void rejectTrial() {
+        if (m_state == State::DownTrial) {
+            // A target miss alone must not provoke the same unsuccessful trial
+            // again. A materially different load can unlock another attempt.
+            m_failedDownMs = m_beforeMs;
+            m_failedDownFps = m_beforeFps;
+        } else {
+            m_upRetryMs = std::min(32000.0, m_upRetryMs * 2);
+        }
+        m_ceiling = m_committed;
+        m_state = State::Steady;
+        m_sourceMs = m_beforeMs;
+        m_budget = 0;
+        m_nextTrial = m_clock + m_upRetryMs;
+        m_slowWindows = 0;
+    }
+
+    void observe(double fps) {
+        const bool meetsTarget = fps >= m_target * 0.97;
+        if (m_state == State::DownTrial) {
+            const bool moreOutput = fps > m_beforeFps * 1.03;
+            const bool fasterReal = m_sourceMs < m_beforeMs * 0.90;
+            const bool preservesOutput = fps >= m_beforeFps * 0.98;
+            if (moreOutput || (fasterReal && (meetsTarget || preservesOutput))) {
+                acceptTrial();
+            } else if (m_ceiling) {
+                // Flow preparation has a fixed cost: try real-only before
+                // concluding that all lower-work choices are ineffective.
+                --m_ceiling;
+                m_budget = 0;
+            } else rejectTrial();
+            return;
+        }
+        if (m_state == State::UpTrial) {
+            if (fps > m_beforeFps * 1.05) acceptTrial();
+            else rejectTrial();
+            return;
+        }
+
+        if (!m_referenceMs) m_referenceMs = m_sourceMs;
+        const bool slowerReal = m_sourceMs > m_referenceMs * 1.25;
+        if (!meetsTarget || slowerReal) m_slowWindows = std::min(2u, m_slowWindows + 1);
+        else m_slowWindows = 0;
+        m_referenceMs = std::min(m_referenceMs, m_sourceMs);
+
+        const bool changedLoad = !m_failedDownMs ||
+            m_sourceMs > m_failedDownMs * 1.25 || fps < m_failedDownFps * 0.85;
+        if (m_clock < m_nextTrial) return;
+        if (m_committed && m_slowWindows >= 2 && changedLoad) {
+            beginTrial(State::DownTrial, m_committed - 1, fps);
+        } else if (m_committed < m_maximum && !meetsTarget) {
+            beginTrial(State::UpTrial, m_committed + 1, fps);
+        }
+    }
+};
+}
