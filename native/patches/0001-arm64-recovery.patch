+  DeferredPresent queue;std::promise<void> started,release;auto gate=release.get_future().share();std::vector<int> order;
+  assert(append(queue,[&]{started.set_value();gate.wait();order.push_back(1);return 0;}));
+  assert(started.get_future().wait_for(2s)==std::future_status::ready);
+  assert(append(queue,[&]{order.push_back(2);return 0;}));
+  assert(append(queue,[&]{order.push_back(3);return 0;}));
+  assert(!append(queue,[]{return 0;})); // At most three deferred presents at 4x.
+  release.set_value();assert(queue.drain()==0);assert((order==std::vector<int>{1,2,3}));
+  assert(append(queue,[]{return -4;}));assert(queue.drain()==-4);assert(!append(queue,[]{return 0;}));
+  std::puts("PASS bounded ordered 4x tail, nonblocking append, sticky errors and drain");
+ }
+}
