+"""Compile the production target zero-generation present with a fake driver.
+
+Covers argument ownership (pNext/pResults preserved, application waits consumed
+exactly once by the history copy), per-swapchain result merging, SUBOPTIMAL
+semantics and the error reset. Not a GPU or performance test.
+"""
+from pathlib import Path
+import subprocess
+
+root = Path(__file__).resolve().parents[1]
+source = (root / 'lsfg-vk-layer/src/modes/vsync.cpp').read_text()
+start = source.index('VkResult VsyncSwapchain::presentTargetNative(')
+end = source.index('\n}\n', start) + 3
+body = source[start:end].replace('VkResult VsyncSwapchain::presentTargetNative(',
+                                 'VkResult presentTargetNative(', 1)
+assert 'invalidateHistory' not in body, 'target zero path must not invalidate history'
+assert body.count('guardedPresent(') == 1, 'application waits must be consumed once'
+
+fixture = r'''
+#include <vulkan/vulkan.h>
+#include <cstdint>
+#include <cstdio>
+#include <vector>
+namespace vk {
+struct CommandBuffer { VkCommandBuffer h{}; };
+struct Queue { VkQueue h{}; };
+struct Image { VkImage h{}; };
+struct Semaphore { VkSemaphore h{}; operator VkSemaphore() const { return h; } };
+}
+struct ContextWrapper {
+    unsigned dispatchCalls = 0;
+    unsigned waitSemaphores = 99;
+    uint32_t lastInsert = 99;
+    VkSemaphore lastReady{};
+    void dispatch(const vk::CommandBuffer&, const vk::Queue&, const vk::Image&,
+                  const std::vector<vk::Semaphore>& waits, uint32_t insert,
+                  const vk::Semaphore& ready) {
+        ++dispatchCalls;
+        waitSemaphores = static_cast<unsigned>(waits.size());
+        lastInsert = insert;
+        lastReady = ready;
+    }
+};
+std::vector<vk::Semaphore> intoCpp(const VkPresentInfoKHR& info) {
+    return std::vector<vk::Semaphore>(info.waitSemaphoreCount);
+}
+VkResult driverReturn = VK_SUCCESS;
+VkResult driverPer = VK_SUCCESS;
+unsigned driverCalls = 0;
+uint32_t lastWaitSemaphoreCount = 0;
+VkSemaphore lastWaitSemaphore{};
+const void* lastNext = nullptr;
+VkResult* lastResults = nullptr;
+VkResult guardedPresent(PFN_vkQueuePresentKHR, VkQueue, const VkPresentInfoKHR* info,
+                        int64_t* start = nullptr) {
+    ++driverCalls;
+    lastWaitSemaphoreCount = info->waitSemaphoreCount;
+    lastWaitSemaphore = info->waitSemaphoreCount ? info->pWaitSemaphores[0] : VkSemaphore{};
+    lastNext = info->pNext;
+    lastResults = info->pResults;
+    if (start) *start = 4242;
+    if (info->pResults) *info->pResults = driverPer;
+    return driverReturn;
+}
+struct Reset {
+    bool cleared = false;
+    void reset() { cleared = true; }
+};
+struct Sched {
+    int64_t recorded = -1;
+    bool cleared = false;
+    void begin(double, unsigned) {}
+    int64_t deadline(int64_t now) const { return now; }
+    void record(int64_t value) { recorded = value; }
+    void reset() { cleared = true; }
+};
+struct Harness {
+    ContextWrapper context;
+    ContextWrapper* m_lsfgvkContext = &context;
+    Reset m_target;
+    Sched m_targetSchedule;
+    unsigned m_deliveredOutputs = 99;
+    int64_t m_previousEntryNs = 7;
+''' + body + r'''
+};
+int main() {
+    VkSemaphore appWaits[2]{};
+    VkSemaphore ready{};
+    ready = reinterpret_cast<VkSemaphore>(0x1234);
+    int pNext = 5;
+    unsigned failures = 0, cases = 0;
+    for (VkResult overall : {VK_SUCCESS, VK_SUBOPTIMAL_KHR, VK_ERROR_OUT_OF_DATE_KHR,
+                             VK_ERROR_DEVICE_LOST}) {
+        for (VkResult per : {VK_SUCCESS, VK_SUBOPTIMAL_KHR, VK_ERROR_OUT_OF_DATE_KHR,
+                             VK_ERROR_DEVICE_LOST}) {
+            for (bool hasResults : {false, true}) {
+                Harness h;
+                driverCalls = 0;
