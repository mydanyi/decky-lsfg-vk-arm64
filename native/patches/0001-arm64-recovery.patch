+/* SPDX-License-Identifier: CC-BY-NC-ND-4.0 */
+#pragma once
+#include <map>
+#include <memory>
+#include <mutex>
+#include <vector>
+#include <vulkan/vulkan.h>
+namespace lsfgvk::layer {
+struct QueueHostEntry {
+    const void* deviceKey;
+    std::shared_ptr<std::mutex> mutex;
+};
+inline std::mutex queueRegistryMutex;
+inline std::map<VkQueue, QueueHostEntry> queueRegistry;
+inline const void* dispatchKey(const void* handle) {
+    return *static_cast<void* const*>(handle);
+}
+inline std::shared_ptr<std::mutex> queueHostMutex(VkQueue queue) {
+    const std::lock_guard registryLock(queueRegistryMutex);
+    const auto it = queueRegistry.find(queue);
+    if (it != queueRegistry.end()) return it->second.mutex;
+    QueueHostEntry entry{dispatchKey(queue), std::make_shared<std::mutex>()};
+    return queueRegistry.emplace(queue, std::move(entry)).first->second.mutex;
+}
+inline std::vector<std::shared_ptr<std::mutex>> deviceQueueMutexes(VkDevice device) {
+    const std::lock_guard registryLock(queueRegistryMutex);
+    std::vector<std::shared_ptr<std::mutex>> result;
+    for (const auto& [queue, entry] : queueRegistry) {
+        (void)queue;
+        if (entry.deviceKey == dispatchKey(device)) result.push_back(entry.mutex);
+    }
+    return result;
+}
+inline void forgetDeviceQueues(VkDevice device) {
+    const std::lock_guard registryLock(queueRegistryMutex);
+    std::erase_if(queueRegistry, [device](const auto& pair) {
+        return pair.second.deviceKey == dispatchKey(device);
+    });
+}
+}
