+#!/usr/bin/env python3
+"""Regression test: LSFG's FINAL original present must propagate pResults.
+
+vkd3d-proton (swapchain.c) passes pResults into vkQueuePresentKHR and does:
+    if (vr == VK_SUCCESS && vk_result != VK_SUCCESS) vr = vk_result;
+LSFG's final original VkPresentInfoKHR omitted pResults, leaving the caller's
+vk_result unwritten. This test extracts the ACTUAL production final-original
+presentInfo2 initializer from lsfg-vk-layer/src/modes/vsync.cpp (the one after
+'// Present the original image') and compiles it into a fixture against the
+bundled Vulkan headers.
+
+Narrow scope, honestly stated: this tests ONLY the extracted initializer's
+pResults plumbing through a fake driver. It does NOT exercise the layer's
+forward() path, GPU presentation, or generated-frame presents.
+
+Usage (operator runs inside remote Docker, choosing a NATIVE compiler there
+so the built exe can be executed directly):
+    python3 present_results_regression.py <native-c++-compiler> <output-directory>
+"""
+
+import os
+import re
+import subprocess
+import sys
+
+
+def extract_initializer(vsync_cpp):
+    with open(vsync_cpp, encoding="utf-8") as source_file:
+        source = source_file.read()
+
+    marker = "// Present the original image"
+    marker_index = source.index(marker)
+    match = re.search(
+        r"const VkPresentInfoKHR presentInfo2\{.*?\};",
+        source[marker_index:],
+        re.DOTALL,
+    )
+    if not match:
+        raise SystemExit(
+            "FAIL: final original presentInfo2 initializer not found in vsync.cpp"
+        )
+    return match.group(0)
+
+
+FIXTURE_PREFIX = r"""#include <vulkan/vulkan.h>
+#include <array>
+#include <cstdio>
+
+static constexpr VkResult SENTINEL = static_cast<VkResult>(0x5E17);
+static VkResult callerResult = SENTINEL;
+static VkResult driverResult = VK_SUCCESS;
+static VkQueue q = (VkQueue)0x1;
+static VkSwapchainKHR sw = (VkSwapchainKHR)0x2;
+static VkSemaphore sem = (VkSemaphore)0x3;
+static uint32_t callerIndex = 3;
+static VkSemaphore presentSemaphore2 = sem;
+
+static VkPresentInfoKHR callerInfo{
+    .sType = VK_STRUCTURE_TYPE_PRESENT_INFO_KHR,
+    .pNext = nullptr,
+    .waitSemaphoreCount = 1,
+    .pWaitSemaphores = &presentSemaphore2,
+    .swapchainCount = 1,
+    .pSwapchains = &sw,
+    .pImageIndices = &callerIndex,
+    .pResults = &callerResult
+};
+static const VkPresentInfoKHR* presentInfo = &callerInfo;
+
+static const VkPresentInfoKHR makeActual() {
+"""
+
+FIXTURE_SUFFIX = r"""    return presentInfo2;
+}
+
+static VkResult fakePresent(VkQueue, const VkPresentInfoKHR* info) {
+    if (info->pResults)
+        info->pResults[0] = driverResult;
+    return driverResult;
+}
+
+static int failures = 0;
+
+static void check(const char* name, bool ok) {
+    std::printf("%s %s\n", ok ? "PASS" : "FAIL", name);
+    if (!ok)
+        failures++;
+}
+
+int main() {
+    const std::array<VkResult, 3> wants{
+        VK_SUCCESS,
+        VK_SUBOPTIMAL_KHR,
+        VK_ERROR_OUT_OF_DATE_KHR
+    };
+
+    for (VkResult want : wants) {
+        driverResult = want;
+        callerResult = SENTINEL;
+        callerInfo.pResults = &callerResult;
+
+        const VkPresentInfoKHR actual = makeActual();
+        (void)fakePresent(q, &actual);
+
+        char name[128];
+        std::snprintf(
+            name,
+            sizeof(name),
+            "final original present result=%d propagated",
+            static_cast<int>(want)
+        );
+        check(name, callerResult == want);
+    }
+
+    driverResult = VK_ERROR_OUT_OF_DATE_KHR;
+    callerResult = SENTINEL;
+    callerInfo.pResults = nullptr;
+
+    const VkPresentInfoKHR actual = makeActual();
+    const VkResult result = fakePresent(q, &actual);
+
+    check(
+        "null pResults: no dereference, sentinel untouched, status returned",
+        result == VK_ERROR_OUT_OF_DATE_KHR && callerResult == SENTINEL
+    );
+
+    std::printf(
+        failures ? "RED: %d failure(s)\n" : "GREEN: all passed\n",
+        failures
+    );
+    return failures ? 1 : 0;
+}
+"""
+
+
+def main():
+    if len(sys.argv) != 3:
+        raise SystemExit(
+            "usage: present_results_regression.py "
+            "<native-c++-compiler> <output-directory>"
+        )
+
+    compiler = sys.argv[1]
+    output_directory = os.path.abspath(sys.argv[2])
+    script_directory = os.path.dirname(os.path.abspath(__file__))
+    repo_directory = os.path.dirname(script_directory)
+    vsync_cpp = os.path.join(
+        repo_directory,
+        "lsfg-vk-layer",
+        "src",
+        "modes",
+        "vsync.cpp",
+    )
+
+    os.makedirs(output_directory, exist_ok=True)
+
+    fixture_cpp = os.path.join(
+        output_directory,
+        "present_results_fixture.cpp",
+    )
+    fixture_exe = os.path.join(
+        output_directory,
+        "present_results_fixture",
+    )
+
+    initializer = extract_initializer(vsync_cpp)
+    fixture_source = (
+        FIXTURE_PREFIX
+        + "    "
+        + initializer.replace("\n", "\n    ")
+        + "\n"
+        + FIXTURE_SUFFIX
+    )
+
+    with open(fixture_cpp, "w", encoding="utf-8") as fixture_file:
+        fixture_file.write(fixture_source)
+
+    subprocess.run(
+        [
+            compiler,
+            "-std=c++20",
+            "-Wall",
+            "-Wextra",
+            "-O0",
+            "-I" + os.path.join(repo_directory, "thirdparty"),
+            fixture_cpp,
+            "-o",
+            fixture_exe,
+        ],
+        check=True,
+    )
+
+    # The operator selects a native compiler inside remote Docker, so this
+    # executable is runnable directly in that same environment.
+    raise SystemExit(subprocess.run([fixture_exe], check=False).returncode)
+
+
+if __name__ == "__main__":
+    main()
