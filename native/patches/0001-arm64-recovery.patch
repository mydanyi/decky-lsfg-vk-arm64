+
+#include "../lsfg-vk-layer/src/modes/deferred_present.hpp"
+
+#include <atomic>
+#include <cassert>
+#include <chrono>
+#include <cstdio>
+#include <functional>
+#include <future>
+#include <memory>
+#include <stdexcept>
+#include <thread>
+
+using lsfgvk::layer::DeferredPresent;
+using namespace std::chrono_literals;
+
+namespace {
+
+template <class Pred>
+bool wait_until(Pred pred, int spins = 4'000'000) {
+    for (int i = 0; i < spins; ++i) {
+        if (pred()) return true;
+        std::this_thread::yield();
+    }
+    return pred();
+}
+
+// submit returns before a blocked callback finishes.
+void test_submit_returns_before_blocked_callback_finishes() {
+    DeferredPresent dp;
+
+    std::atomic<bool> started{false};
+    std::atomic<bool> finished{false};
+    std::promise<void> gate;
+    auto gate_fut = gate.get_future().share();
+
+    auto sub = std::async(std::launch::async, [&] {
+        return dp.submit([&]() -> int {
+            started.store(true);
+            gate_fut.wait();
+            finished.store(true);
+            return 0;
+        });
+    });
+
+    assert(wait_until([&] { return started.load(); }));
+    assert(sub.wait_for(50ms) == std::future_status::ready);
+    assert(sub.get() == true);
+    assert(!finished.load());
+
+    gate.set_value();
+    assert(dp.drain() == 0);
+    assert(finished.load());
+}
+
+// submit rejects an overlapping submission while one is pending.
+void test_submit_rejects_overlapping() {
+    DeferredPresent dp;
+
+    std::atomic<bool> started{false};
+    std::promise<void> gate;
+    auto gate_fut = gate.get_future().share();
+
+    assert(dp.submit([&]() -> int {
+        started.store(true);
+        gate_fut.wait();
+        return 0;
+    }));
+    assert(wait_until([&] { return started.load(); }));
+
+    assert(dp.submit([] { return 0; }) == false);
+
+    gate.set_value();
+    assert(dp.drain() == 0);
+}
+
+// drain blocks until the pending callback completes.
+void test_drain_waits_for_completion() {
+    DeferredPresent dp;
+
+    std::atomic<bool> started{false};
+    std::atomic<bool> finished{false};
+    std::promise<void> gate;
+    auto gate_fut = gate.get_future().share();
+
+    assert(dp.submit([&]() -> int {
+        started.store(true);
+        gate_fut.wait();
+        finished.store(true);
+        return 0;
+    }));
+    assert(wait_until([&] { return started.load(); }));
+
+    auto drained = std::async(std::launch::async, [&] { return dp.drain(); });
+    assert(drained.wait_for(50ms) == std::future_status::timeout);
+    assert(!finished.load());
+
+    gate.set_value();
+    assert(drained.get() == 0);
+    assert(finished.load());
+}
+
+// The object is reusable after a successful drain.
+void test_reuse_after_success() {
+    DeferredPresent dp;
+
+    assert(dp.submit([] { return 0; }));
+    assert(dp.drain() == 0);
+
+    assert(dp.submit([] { return 0; }));
+    assert(dp.drain() == 0);
+
+    assert(dp.submit([] { return 0; }));
+    assert(dp.drain() == 0);
+}
+
+// A nonzero callback error is latched and sticky.
+void test_sticky_error_latched() {
+    DeferredPresent dp;
+
+    assert(dp.submit([] { return -4; }));
+    assert(dp.drain() == -4);
+    assert(dp.drain() == -4);
+
+    assert(dp.submit([] { return 0; }) == false);
+    assert(dp.drain() == -4);
+}
+
+// A thrown callback becomes -1 and is latched.
+void test_thrown_callback_yields_minus_one() {
+    DeferredPresent dp;
+
+    assert(dp.submit([]() -> int { throw std::runtime_error("boom"); }));
+    assert(dp.drain() == -1);
+    assert(dp.drain() == -1);
+
+    assert(dp.submit([] { return 0; }) == false);
+}
+
+// Destruction waits for an in-flight callback to complete.
+void test_destruction_waits_for_callback() {
+    auto dp = std::make_unique<DeferredPresent>();
+
+    std::atomic<bool> finished{false};
+    std::promise<void> started;
+    auto started_fut = started.get_future();
+    std::promise<void> gate;
+    auto gate_fut = gate.get_future().share();
+
+    assert(dp->submit([&]() -> int {
+        started.set_value();
+        gate_fut.wait();
+        finished.store(true);
+        return 0;
+    }));
+    started_fut.wait();
+
+    auto destroyer = std::async(std::launch::async, [&] { dp.reset(); });
+    assert(destroyer.wait_for(50ms) == std::future_status::timeout);
+    assert(!finished.load());
+
+    gate.set_value();
+    destroyer.get();
+    assert(finished.load());
+}
+
+}  // namespace
+
+int main() {
+    test_submit_returns_before_blocked_callback_finishes();
+    test_submit_rejects_overlapping();
+    test_drain_waits_for_completion();
+    test_reuse_after_success();
+    test_sticky_error_latched();
+    test_thrown_callback_yields_minus_one();
+    test_destruction_waits_for_callback();
+    std::puts("all DeferredPresent tests passed");
+    return 0;
+}
