+// Production closed loop: TargetController selects work and TargetPresentSchedule
+// supplies every generated/original submission deadline. The fake clock advances
+// through generation plus those actual waits, and the next QueuePresent entry is
+// fed back to the controller. This is a policy/scheduling test, not a scanout
+// claim: display refresh is an independent capability (144 Hz here), while the
+// target remains 60 or 120 Hz.
+#include "target_controller.hpp"
+#include "target_present_schedule.hpp"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdio>
+#include <set>
+
+using lsfgvk::layer::TargetController;
+using lsfgvk::layer::TargetPresentSchedule;
+
+namespace {
+int failures = 0;
+void check(bool ok, const char* name) {
+    std::printf("%s %s\n", ok ? "PASS" : "FAIL", name);
+    failures += !ok;
+}
+
+struct Workload {
+    double capFps;             // 0 means uncapped serial rendering.
+    double renderMs;
+    double generatedWorkMs;
+    double displayHz;
+};
+
+struct Result {
+    double outputFps{};
+    double meanOutputs{};
+    double waitedMs{};
+    std::set<unsigned> generatedCounts;
+};
+
+Result simulate(const Workload& work, unsigned targetFps, unsigned maximum,
+                bool protection, int iterations = 9000, int sample = 1500) {
+    TargetController controller;
+    TargetPresentSchedule schedule;
+    double entryMs = 0.0;
+    double previousEntryMs = 0.0;
+    unsigned previousDelivered = 0;
+    double sampleStartMs = 0.0;
+    double nextDisplayMs = 0.0;
+    const double displayPeriodMs = 1000.0 / work.displayHz;
+    double delivered = 0.0;
+    double waited = 0.0;
+    std::set<unsigned> counts;
+
+    for (int frame = 0; frame < iterations; ++frame) {
+        const double elapsedMs = frame ? entryMs - previousEntryMs : 0.0;
+        previousEntryMs = entryMs;
+        const unsigned generated = controller.update(
+            elapsedMs, targetFps, maximum, protection, previousDelivered);
+        const unsigned outputs = generated + 1;
+        schedule.begin(controller.sourcePeriodMs(), outputs);
+
+        double nowMs = entryMs;
+        if (generated == 0) {
+            // Production presentTargetNative records the original immediately; it
+            // does not request a one-output pacing deadline.
+            schedule.record(static_cast<int64_t>(std::llround(nowMs * 1e6)));
+        } else {
+            for (unsigned ordinal = 0; ordinal < outputs; ++ordinal) {
+                if (ordinal < generated) nowMs += work.generatedWorkMs;
+                const auto nowNs = static_cast<int64_t>(std::llround(nowMs * 1e6));
+                const auto deadlineNs = schedule.deadline(nowNs);
+                waited += static_cast<double>(deadlineNs - nowNs) / 1e6;
+                nowMs = static_cast<double>(deadlineNs) / 1e6;
+                const double displayReadyMs = std::max(nowMs, nextDisplayMs);
+                waited += displayReadyMs - nowMs;
+                nowMs = displayReadyMs;
+                nextDisplayMs = displayReadyMs + displayPeriodMs;
+                schedule.record(static_cast<int64_t>(std::llround(nowMs * 1e6)));
+            }
+        }
+
+        previousDelivered = outputs;
+        const double completedMs = nowMs;
+        if (work.capFps > 0.0) {
+            // A manual cap fixes the next source entry unless this batch itself
+            // overruns it. The target scheduler's tail wait is therefore real
+            // feedback, rather than max(work, displayPeriod * outputs).
+            entryMs = std::max(previousEntryMs + 1000.0 / work.capFps, completedMs);
+        } else {
+            // Uncapped serial rendering starts only after the batch completes.
+            entryMs = completedMs + work.renderMs;
+        }
+
+        if (frame == iterations - sample) {
+            sampleStartMs = previousEntryMs;
+            delivered = 0.0;
+            waited = 0.0;
+            counts.clear();
+        }
+        if (frame >= iterations - sample) {
+            delivered += outputs;
+            counts.insert(generated);
+        }
+    }
+
+    const double durationMs = previousEntryMs - sampleStartMs;
+    return Result{
+        .outputFps = durationMs > 0.0 ? delivered * 1000.0 / durationMs : 0.0,
+        .meanOutputs = delivered / sample,
+        .waitedMs = waited,
+        .generatedCounts = std::move(counts),
+    };
+}
+
+bool near(double value, double expected, double tolerance) {
+    return std::abs(value - expected) <= tolerance;
+}
+} // namespace
+
+int main() {
+    const Workload cap30{30.0, 0.0, 1.0, 144.0};
+    const Result to60 = simulate(cap30, 60, 3, true);
+    check(60.0 < cap30.displayHz, "closed loop: 60 target is independent of 144 Hz display");
+    check(near(to60.meanOutputs, 2.0, 0.03),
+          "closed loop: cap 30 to target 60 selects two delivered outputs");
+    check(near(to60.outputFps, 60.0, 1.5),
+          "closed loop: cap 30 to target 60 reaches the requested submission cadence");
+    check(to60.waitedMs > 0.0,
+          "closed loop: cap 30 to 60 exercised production schedule deadlines and waits");
+
+    const Workload cap50{50.0, 0.0, 1.0, 144.0};
+    const Result to120 = simulate(cap50, 120, 3, true);
+    check(120.0 < cap50.displayHz, "closed loop: 120 target is not treated as a 60 Hz display");
+    check(near(to120.outputFps, 120.0, 3.0),
+          "closed loop: cap 50 to target 120 reaches the requested submission cadence");
+    check(to120.meanOutputs >= 2.35 && to120.meanOutputs <= 2.55,
+          "closed loop: cap 50 to 120 keeps a bounded mixed output budget under 144 Hz backpressure");
+    check(to120.generatedCounts.count(1) && to120.generatedCounts.count(2),
+          "closed loop: cap 50 to 120 uses mixed one/two generated-frame batches");
+    check(to120.waitedMs > 0.0,
+          "closed loop: cap 50 to 120 accumulates actual schedule waits");
+
+    // With no cap, generated work and the original tail are serial. One generated
+    // frame lowers delivered outputs/time below the native real-only cadence, so
+    // overload protection must retain the more useful original frames. The target
+    // is intentionally unreachable; generation is not asserted merely to preserve FG.
+    const Workload serialOverload{0.0, 12.0, 20.0, 144.0};
+    const Result overloaded = simulate(serialOverload, 120, 3, true, 14000, 2500);
+    check(overloaded.meanOutputs < 1.02 && overloaded.generatedCounts.count(0),
+          "closed loop: uncapped serial overload spends essentially all steady-state frames real-only");
+    check(overloaded.outputFps >= 78.0,
+          "closed loop: unreachable target retains the higher native output cadence");
+
+    // Turning protection off leaves target scheduling active even under the same
+    // serial load; this distinguishes overload backoff from the target budget.
+    const Result unprotected = simulate(serialOverload, 120, 3, false, 4000, 800);
+    check(unprotected.generatedCounts.count(1) || unprotected.generatedCounts.count(2) ||
+          unprotected.generatedCounts.count(3),
+          "closed loop: disabling protection does not disable target scheduling");
+
+    std::printf("  cap30->60: outputs=%.3f fps=%.2f wait_ms=%.2f\n",
+                to60.meanOutputs, to60.outputFps, to60.waitedMs);
+    std::printf("  cap50->120: outputs=%.3f fps=%.2f wait_ms=%.2f\n",
+                to120.meanOutputs, to120.outputFps, to120.waitedMs);
+    std::printf("  uncapped overload: outputs=%.3f fps=%.2f wait_ms=%.2f\n",
+                overloaded.meanOutputs, overloaded.outputFps, overloaded.waitedMs);
+    return failures ? 1 : 0;
+}
