+/* SPDX-License-Identifier: CC-BY-NC-ND-4.0 */
+#pragma once
+
+#include <condition_variable>
+#include <cstddef>
+#include <deque>
+#include <functional>
+#include <mutex>
+#include <thread>
+#include <utility>
+
+namespace lsfgvk::layer {
+
+class DeferredPresent {
+public:
+    DeferredPresent() = default;
+    DeferredPresent(const DeferredPresent&) = delete;
+    DeferredPresent& operator=(const DeferredPresent&) = delete;
+
+    ~DeferredPresent() {
+        {
+            std::unique_lock<std::mutex> lock(mutex_);
+            idleCv_.wait(lock, [this] { return pending_ == 0; });
+            stopping_ = true;
+        }
+        cv_.notify_all();
+        if (worker_.joinable()) worker_.join();
+    }
+
+    bool submit(std::function<int()> job) {
+        return enqueue(std::move(job), false);
+    }
+
+    bool append(std::function<int()> job) {
+        return enqueue(std::move(job), true);
+    }
+
+    int drain() {
+        std::unique_lock<std::mutex> lock(mutex_);
+        idleCv_.wait(lock, [this] { return pending_ == 0; });
+        return sticky_;
+    }
+
+private:
+    static constexpr std::size_t kMaxPending = 3;
+
+    bool enqueue(std::function<int()> job, bool allowBusy) {
+        std::unique_lock<std::mutex> lock(mutex_);
+        if (stopping_ || sticky_ != 0) return false;
+        if (!allowBusy && pending_ != 0) return false;
+        if (pending_ >= kMaxPending) return false;
+
+        if (!worker_.joinable()) {
+            try {
+                worker_ = std::thread([this] { run(); });
+            } catch (...) {
+                return false;
+            }
+        }
+
+        try {
+            tasks_.push_back(std::move(job));
+        } catch (...) {
+            return false;
+        }
+
+        ++pending_;
+        cv_.notify_one();
+        return true;
+    }
+
+    void run() {
+        for (;;) {
+            std::function<int()> job;
+            {
+                std::unique_lock<std::mutex> lock(mutex_);
+                cv_.wait(lock, [this] { return stopping_ || !tasks_.empty(); });
+                if (tasks_.empty()) {
+                    if (stopping_) return;
+                    continue;
+                }
+                job = std::move(tasks_.front());
+                tasks_.pop_front();
+            }
+
+            int result = -1;
+            try {
+                result = job();
+            } catch (...) {
+                result = -1;
+            }
+
+            {
+                std::unique_lock<std::mutex> lock(mutex_);
+                if (result != 0 && sticky_ == 0) sticky_ = result;
+                if (--pending_ == 0) idleCv_.notify_all();
+            }
+        }
+    }
+
+    std::mutex mutex_;
+    std::condition_variable cv_;
+    std::condition_variable idleCv_;
+    std::deque<std::function<int()>> tasks_;
+    std::size_t pending_ = 0;
+    int sticky_ = 0;
+    bool stopping_ = false;
+    std::thread worker_;
+};
+
+} // namespace lsfgvk::layer
