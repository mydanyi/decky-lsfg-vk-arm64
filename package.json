{
  "name": "decky-lsfg-vk-arm64",
  "version": "0.12.8-armada-lsfg2.20260913.8-preview.1",
  "description": "LSFG-VK ARM64: Armada integration, lsfg-vk 2.0 configuration and Chinese UI",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "test": "node --test tests/*.cjs",
    "test:backend": "python3 -m unittest discover -s tests -v"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mydanyi/decky-lsfg-vk-arm64.git"
  },
  "keywords": [
    "decky",
    "plugin",
    "steam-deck",
    "deck",
    "lossless-scaling",
    "frame-generation",
    "lsfg-vk",
    "framegen"
  ],
  "author": "Kurt Himebauch <dkh4830@gmail.com>",
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/mydanyi/decky-lsfg-vk-arm64/issues"
  },
  "homepage": "https://github.com/mydanyi/decky-lsfg-vk-arm64#readme",
  "devDependencies": {
    "@decky/rollup": "^1.0.1",
    "@decky/ui": "^4.7.2",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@types/webpack": "^5.28.5",
    "rollup": "^4.22.5",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.2",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.22.5",
    "@rollup/rollup-linux-x64-musl": "4.22.5"
  },
  "remote_binary_bundling": false,
  "remote_binary": [],
  "pnpm": {
    "supportedArchitectures": {
      "cpu": ["arm64", "x64"],
      "libc": ["glibc", "musl"],
      "os": ["darwin", "linux"]
    },
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
